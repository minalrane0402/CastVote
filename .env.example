# GEMINI_API_KEY: Required for CastVote Gemini AI Features (AI Poll Generator & Q&A Summarizer).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Self-referential URL where app is hosted
APP_URL="http://localhost:3000"

# Optional Firebase Cloud Firestore Credentials (Free Tier)
# Paste your Firebase Web Config values below to enable zero-latency cloud persistence
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
