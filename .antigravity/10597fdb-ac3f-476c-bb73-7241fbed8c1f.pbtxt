  file_change {
    absolute_path_uri: "file:///src/components/PresenterControl.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { \n  Plus, Trash2, Play, Square, Check, Copy, ExternalLink, \n  MessageSquare, Vote, RefreshCw, AlertTriangle, Sparkles, Monitor, EyeOff, Eye\n} from \"lucide-react\";\nimport { Room, Poll, Question } from \"../types\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\ninterface PresenterControlProps {\n  room: Room;\n  onCreatePoll: (question: string, options: string[]) => void;\n  onActivatePoll: (pollId: string) => void;\n  onClosePoll: (pollId: string) => void;\n  onDeletePoll: (pollId: string) => void;\n  onToggleAnswered: (questionId: string) => void;\n  onToggleArchive: (questionId: string) => void;\n  onDeleteQuestion: (questionId: string) => void;\n  onForceRefresh: () => void;\n  isSyncing: boolean;\n  onOpenProjector: () => void;\n}\n\nexport default function PresenterControl({\n  room,\n  onCreatePoll,\n  onActivatePoll,\n  onClosePoll,\n  onDeletePoll,\n  onToggleAnswered,\n  onToggleArchive,\n  onDeleteQuestion,\n  onForceRefresh,\n  isSyncing,\n  onOpenProjector,\n}: PresenterControlProps) {\n  const [activeSubTab, setActiveSubTab] = useState<\"polls\" | \"qa\">(\"polls\");\n  const [copied, setCopied] = useState(false);\n  \n  // Create Poll State\n  const [newQuestion, setNewQuestion] = useState(\"\");\n  const [newOptions, setNewOptions] = useState<string[]>([\"\", \"\"]);\n  const [qaFilter, setQaFilter] = useState<\"active\" | \"answered\" | \"archived\">(\"active\");\n\n  const handleCopyLink = () => {\n    const joinUrl = `${window.location.origin}/#/room/${room.id}`;\n    navigator.clipboard.writeText(joinUrl);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  const handleAddOption = () => {\n    if (newOptions.length < 8) {\n      setNewOptions([...newOptions, \"\"]);\n    }\n  };\n\n  const handleRemoveOption = (index: number) => {\n    if (newOptions.length > 2) {\n      setNewOptions(newOptions.filter((_, idx) => idx !== index));\n    }\n  };\n\n  const handleOptionChange = (index: number, val: string) => {\n    const updated = [...newOptions];\n    updated[index] = val;\n    setNewOptions(updated);\n  };\n\n  const handleCreatePollSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newQuestion.trim()) return;\n    \n    // Filter empty options\n    const filteredOptions = newOptions.map(o => o.trim()).filter(Boolean);\n    if (filteredOptions.length < 2) return;\n\n    onCreatePoll(newQuestion.trim(), filteredOptions);\n    \n    // Reset Form\n    setNewQuestion(\"\");\n    setNewOptions([\"\", \"\"]);\n  };\n\n  // Helper to count votes on a poll\n  const getTotalVotes = (poll: Poll) => {\n    return Object.values(poll.votes).reduce((sum, count) => sum + count, 0);\n  };\n\n  // Q&A Filtering & Sorting\n  const filteredQuestions = room.questions.filter(q => {\n    if (qaFilter === \"answered\") return q.isAnswered && !q.isArchived;\n    if (qaFilter === \"archived\") return q.isArchived;\n    return !q.isAnswered && !q.isArchived; // active\n  }).sort((a, b) => b.upvotes - a.upvotes); // sorted by upvotes desc\n\n  const activePoll = room.polls.find(p => p.isActive);\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 flex flex-col justify-between font-sans\">\n      {/* Dashboard Header */}\n      <header className=\"border-b border-slate-200 bg-white shadow-xs sticky top-0 z-40 px-4 sm:px-6 lg:px-8 py-4\">\n        <div className=\"max-w-7xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-4\">\n          \n          {/* Logo & Title */}\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"bg-indigo-600 text-white p-2.5 rounded-xl shadow-lg shadow-indigo-100 flex items-center justify-center\">\n              <Vote className=\"h-5 w-5\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"font-extrabold text-lg text-slate-900 tracking-tight\">PulseLive Presenter</span>\n                <span className=\"text-[10px] bg-slate-100 text-slate-500 font-bold px-2 py-0.5 rounded-md border border-slate-200\">\n                  Control Panel\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-500 font-medium\">\n                Event: <span className=\"text-slate-800 font-semibold\">{room.title}</span>\n              </p>\n            </div>\n          </div>\n\n          {/* Quick Stats / Codes & Shares */}\n          <div className=\"flex flex-wrap items-center gap-3\">\n            <div className=\"bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-xl text-center\">\n              <span className=\"block text-[9px] uppercase font-bold tracking-wider text-slate-400\">Room Code</span>\n              <span className=\"font-mono text-sm font-black text-indigo-600 tracking-wider uppercase\">{room.id}</span>\n            </div>\n\n            <button\n              onClick={handleCopyLink}\n              className=\"px-4 py-2 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 hover:text-slate-900 font-semibold rounded-xl text-xs flex items-center gap-1.5 transition-all shadow-xs\"\n            >\n              {copied ? <Check className=\"h-3.5 w-3.5 text-emerald-600\" /> : <Copy className=\"h-3.5 w-3.5 text-slate-400\" />}\n              {copied ? \"Copied Link!\" : \"Copy Guest Link\"}\n            </button>\n\n            <button\n              onClick={onOpenProjector}\n              className=\"px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl text-xs flex items-center gap-1.5 transition-all shadow-md shadow-indigo-100\"\n            >\n              <Monitor className=\"h-3.5 w-3.5\" />\n              Open Projector View\n            </button>\n\n            <button\n              onClick={onForceRefresh}\n              className={`p-2 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors ${\n                isSyncing ? \"text-indigo-600\" : \"text-slate-400 hover:text-slate-600\"\n              }`}\n              title=\"Force sync data\"\n            >\n              <RefreshCw className={`h-4 w-4 ${isSyncing ? \"animate-spin\" : \"\"}`} />\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Grid */}\n      <main className=\"flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 grid grid-cols-12 gap-8 items-start\">\n        \n        {/* Left Hand: Tab Selection & Quick Status (Col 1-3) */}\n        <section className=\"col-span-12 md:col-span-3 space-y-4\">\n          <div className=\"bg-white border border-slate-200/80 rounded-2xl p-4 shadow-sm space-y-2\">\n            <h3 className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-2 px-1\">\n              Presenter Tabs\n            </h3>\n            \n            <button\n              onClick={() => setActiveSubTab(\"polls\")}\n              className={`w-full flex items-center justify-between p-3 rounded-xl text-xs font-bold transition-all ${\n                activeSubTab === \"polls\"\n                  ? \"bg-indigo-50 text-indigo-700 border border-indigo-100 shadow-xs\"\n                  : \"text-slate-600 hover:bg-slate-50 border border-transparent\"\n              }`}\n            >\n              <span className=\"flex items-center gap-2\">\n                <Vote className=\"h-4 w-4\" /> Manage Polls\n              </span>\n              <span className=\"bg-slate-200/60 text-slate-700 font-black px-2 py-0.5 rounded-md text-[10px]\">\n                {room.polls.length}\n              </span>\n            </button>\n\n            <button\n              onClick={() => setActiveSubTab(\"qa\")}\n              className={`w-full flex items-center justify-between p-3 rounded-xl text-xs font-bold transition-all ${\n                activeSubTab === \"qa\"\n                  ? \"bg-indigo-50 text-indigo-700 border border-indigo-100 shadow-xs\"\n                  : \"text-slate-600 hover:bg-slate-50 border border-transparent\"\n              }`}\n            >\n              <span className=\"flex items-center gap-2\">\n                <MessageSquare className=\"h-4 w-4\" /> Audience Q&A\n              </span>\n              <span className=\"bg-slate-200/60 text-slate-700 font-black px-2 py-0.5 rounded-md text-[10px]\">\n                {room.questions.filter(q => !q.isArchived).length}\n              </span>\n            </button>\n          </div>\n\n          {/* Quick Onboarding Tip */}\n          <div className=\"bg-amber-50/50 border border-amber-200/50 rounded-2xl p-4 shadow-xs text-xs space-y-2.5\">\n            <h4 className=\"font-bold text-amber-800 flex items-center gap-1.5\">\n              <Sparkles className=\"h-3.5 w-3.5 text-amber-600\" /> Presenter Tip\n            </h4>\n            <p className=\"text-amber-700 leading-relaxed font-normal\">\n              Open the **Projector View** on your presentation screen or TV. It has large-format graphics and a big QR code, which stays fully synced with this dashboard in real time!\n            </p>\n          </div>\n        </section>\n\n        {/* Right Hand: Interactive Workspaces (Col 4-12) */}\n        <section className=\"col-span-12 md:col-span-9 bg-white border border-slate-200/80 rounded-2xl p-6 shadow-sm min-h-[500px]\">\n          <AnimatePresence mode=\"wait\">\n            {activeSubTab === \"polls\" ? (\n              <motion.div\n                key=\"tab-polls\"\n                initial={{ opacity: 0, y: 5 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: -5 }}\n                transition={{ duration: 0.15 }}\n                className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\"\n              >\n                {/* Create Poll Box (Lg: Col 1-5) */}\n                <div className=\"lg:col-span-5 space-y-4\">\n                  <div className=\"border-b border-slate-100 pb-3\">\n                    <h3 className=\"font-extrabold text-slate-900 text-sm\">Create a New Poll</h3>\n                    <p className=\"text-[11px] text-slate-500\">Add options for multi-choice response.</p>\n                  </div>\n\n                  <form onSubmit={handleCreatePollSubmit} className=\"space-y-4\">\n                    <div className=\"space-y-1.5\">\n                      <label className=\"text-[11px] font-bold text-slate-400 uppercase tracking-wider\">\n                        Question Text\n                      </label>\n                      <input\n                        type=\"text\"\n                        required\n                        value={newQuestion}\n                        onChange={(e) => setNewQuestion(e.target.value)}\n                        placeholder=\"e.g. Which project should we prioritize next?\"\n                        className=\"w-full bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:bg-white focus:outline-none rounded-xl px-3.5 py-2.5 text-xs font-medium transition-all\"\n                      />\n                    </div>\n\n                    <div className=\"space-y-2.5\">\n                      <label className=\"text-[11px] font-bold text-slate-400 uppercase tracking-wider block\">\n                        Answer Options\n                      </label>\n                      \n                      {newOptions.map((option, idx) => (\n                        <div key={idx} className=\"flex items-center gap-2\">\n                          <span className=\"text-[11px] font-mono text-slate-400 font-bold shrink-0 w-4\">\n                            {idx + 1}.\n                          </span>\n                          <input\n                            type=\"text\"\n                            required\n                            value={option}\n                            onChange={(e) => handleOptionChange(idx, e.target.value)}\n                            placeholder={`Option ${idx + 1}`}\n                            className=\"flex-grow bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:bg-white focus:outline-none rounded-xl px-3 py-2 text-xs font-medium transition-all\"\n                          />\n                          {newOptions.length > 2 && (\n                            <button\n                              type=\"button\"\n                              onClick={() => handleRemoveOption(idx)}\n                              className=\"text-slate-400 hover:text-rose-600 p-1 rounded-lg hover:bg-slate-100 transition-colors\"\n                            >\n                              <Trash2 className=\"h-3.5 w-3.5\" />\n                            </button>\n                          )}\n                        </div>\n                      ))}\n\n                      {newOptions.length < 8 && (\n                        <button\n                          type=\"button\"\n                          onClick={handleAddOption}\n                          className=\"text-indigo-600 hover:text-indigo-700 text-xs font-bold flex items-center gap-1 mt-2 px-1 py-1 rounded-md hover:bg-indigo-50/50 transition-colors\"\n                        >\n                          <Plus className=\"h-3.5 w-3.5\" /> Add Option\n                        </button>\n                      )}\n                    </div>\n\n                    <button\n                      type=\"submit\"\n                      disabled={!newQuestion.trim() || newOptions.filter(Boolean).length < 2}\n                      className=\"w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 disabled:bg-slate-100 text-white disabled:text-slate-400 font-bold rounded-xl text-xs shadow-md shadow-indigo-100 transition-all flex items-center justify-center gap-1.5\"\n                    >\n                      <Plus className=\"h-4 w-4\" /> Create Poll\n                    </button>\n                  </form>\n                </div>\n\n                {/* Polls list & visualizer (Lg: Col 6-12) */}\n                <div className=\"lg:col-span-7 space-y-5\">\n                  <div className=\"border-b border-slate-100 pb-3 flex justify-between items-center\">\n                    <div>\n                      <h3 className=\"font-extrabold text-slate-900 text-sm\">Session Polls</h3>\n                      <p className=\"text-[11px] text-slate-500\">Currently configured voting panels.</p>\n                    </div>\n                    {activePoll && (\n                      <span className=\"bg-indigo-50 text-indigo-700 font-bold px-2 py-0.5 rounded-md border border-indigo-200 text-[10px] animate-pulse flex items-center gap-1\">\n                        <span className=\"h-1.5 w-1.5 rounded-full bg-indigo-600\"></span> 1 Poll Active\n                      </span>\n                    )}\n                  </div>\n\n                  {room.polls.length === 0 ? (\n                    <div className=\"border-2 border-dashed border-slate-200 rounded-2xl p-12 text-center text-slate-400 text-xs\">\n                      No polls created yet. Fill out the form on the left to start collecting audience feedback!\n                    </div>\n                  ) : (\n                    <div className=\"space-y-4\">\n                      {room.polls.map((poll) => {\n                        const totalVotes = getTotalVotes(poll);\n                        return (\n                          <div\n                            key={poll.id}\n                            className={`p-4 border rounded-2xl space-y-3 transition-all bg-white relative overflow-hidden ${\n                              poll.isActive \n                                ? \"border-indigo-500 ring-2 ring-indigo-50\" \n                                : \"border-slate-200\"\n                            }`}\n                          >\n                            <div className=\"flex justify-between items-start gap-4\">\n                              <div className=\"space-y-1 min-w-0\">\n                                <div className=\"flex items-center gap-2\">\n                                  <h4 className=\"font-extrabold text-xs sm:text-sm text-slate-900 truncate leading-snug\">\n                                    {poll.question}\n                                  </h4>\n                                  {poll.isActive ? (\n                                    <span className=\"bg-emerald-50 text-emerald-700 font-bold text-[9px] uppercase px-1.5 py-0.5 rounded-md border border-emerald-200 flex items-center shrink-0\">\n                                      Active\n                                    </span>\n                                  ) : poll.isClosed ? (\n                                    <span className=\"bg-slate-100 text-slate-500 font-bold text-[9px] uppercase px-1.5 py-0.5 rounded-md border border-slate-200 flex items-center shrink-0\">\n                                      Closed\n                                    </span>\n                                  ) : (\n                                    <span className=\"bg-slate-50 text-slate-400 font-bold text-[9px] uppercase px-1.5 py-0.5 rounded-md border border-slate-200 flex items-center shrink-0\">\n                                      Draft\n                                    </span>\n                                  )}\n                                </div>\n                                <p className=\"text-[10px] font-mono font-medium text-slate-400 uppercase tracking-wider\">\n                                  {totalVotes} {totalVotes === 1 ? \"response\" : \"responses\"}\n                                </p>\n                              </div>\n\n                              {/* Controls */}\n                              <div className=\"flex items-center gap-1.5 shrink-0\">\n                                {!poll.isActive && !poll.isClosed && (\n                                  <button\n                                    onClick={() => onActivatePoll(poll.id)}\n                                    className=\"p-1.5 bg-indigo-50 text-indigo-600 hover:bg-indigo-100 rounded-lg text-xs font-bold transition-all flex items-center gap-1 border border-indigo-100\"\n                                    title=\"Activate voting for guests\"\n                                  >\n                                    <Play className=\"h-3 w-3 fill-indigo-600\" /> Launch\n                                  </button>\n                                )}\n                                {poll.isActive && (\n                                  <button\n                                    onClick={() => onClosePoll(poll.id)}\n                                    className=\"p-1.5 bg-rose-50 text-rose-600 hover:bg-rose-100 rounded-lg text-xs font-bold transition-all flex items-center gap-1 border border-rose-100\"\n                                    title=\"Close voting\"\n                                  >\n                                    <Square className=\"h-3 w-3 fill-rose-600\" /> Close\n                                  </button>\n                                )}\n                                {poll.isClosed && (\n                                  <button\n                                    onClick={() => onActivatePoll(poll.id)}\n                                    className=\"p-1.5 bg-slate-50 text-slate-600 hover:bg-slate-100 rounded-lg text-xs font-bold transition-all flex items-center gap-1 border border-slate-200\"\n                                    title=\"Re-open voting\"\n                                  >\n                                    <RefreshCw className=\"h-3 w-3\" /> Re-launch\n                                  </button>\n                                )}\n                                <button\n                                  onClick={() => onDeletePoll(poll.id)}\n                                  className=\"p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors border border-transparent hover:border-rose-100\"\n                                  title=\"Delete poll\"\n                                >\n                                  <Trash2 className=\"h-3.5 w-3.5\" />\n                                </button>\n                              </div>\n                            </div>\n\n                            {/* Options visualization */}\n                            <div className=\"space-y-2 pt-2 border-t border-slate-50\">\n                              {poll.options.map((option, index) => {\n                                const votes = poll.votes[index] || 0;\n                                const percentage = totalVotes > 0 \n                                  ? Math.round((votes / totalVotes) * 100) \n                                  : 0;\n\n                                return (\n                                  <div key={index} className=\"space-y-1 text-xs\">\n                                    <div className=\"flex justify-between font-medium text-slate-600\">\n                                      <span className=\"truncate pr-3\">{option}</span>\n                                      <span className=\"font-semibold text-slate-800 shrink-0\">\n                                        {percentage}% ({votes})\n                                      </span>\n                                    </div>\n                                    <div className=\"h-2 w-full bg-slate-100 rounded-md overflow-hidden relative\">\n                                      <div\n                                        style={{ width: `${percentage}%` }}\n                                        className={`h-full rounded-md transition-all duration-300 ${\n                                          poll.isActive ? \"bg-indigo-600\" : \"bg-slate-400\"\n                                        }`}\n                                      ></div>\n                                    </div>\n                                  </div>\n                                );\n                              })}\n                            </div>\n                          </div>\n                        );\n                      })}\n                    </div>\n                  )}\n                </div>\n              </motion.div>\n            ) : (\n              // Q&A Moderation Panel\n              <motion.div\n                key=\"tab-qa\"\n                initial={{ opacity: 0, y: 5 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: -5 }}\n                transition={{ duration: 0.15 }}\n                className=\"space-y-5\"\n              >\n                <div className=\"border-b border-slate-100 pb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3\">\n                  <div>\n                    <h3 className=\"font-extrabold text-slate-900 text-sm\">Audience Q&A Moderation</h3>\n                    <p className=\"text-[11px] text-slate-500\">Filter, upvote, and flag audience questions live.</p>\n                  </div>\n\n                  {/* Filters */}\n                  <div className=\"flex bg-slate-100 p-0.5 rounded-lg border border-slate-200 text-xs\">\n                    <button\n                      onClick={() => setQaFilter(\"active\")}\n                      className={`px-3 py-1 font-bold rounded-md transition-all ${\n                        qaFilter === \"active\"\n                          ? \"bg-white text-slate-950 shadow-xs\"\n                          : \"text-slate-500 hover:text-slate-700\"\n                      }`}\n                    >\n                      Unanswered ({room.questions.filter(q => !q.isAnswered && !q.isArchived).length})\n                    </button>\n                    <button\n                      onClick={() => setQaFilter(\"answered\")}\n                      className={`px-3 py-1 font-bold rounded-md transition-all ${\n                        qaFilter === \"answered\"\n                          ? \"bg-white text-slate-950 shadow-xs\"\n                          : \"text-slate-500 hover:text-slate-700\"\n                      }`}\n                    >\n                      Answered ({room.questions.filter(q => q.isAnswered && !q.isArchived).length})\n                    </button>\n                    <button\n                      onClick={() => setQaFilter(\"archived\")}\n                      className={`px-3 py-1 font-bold rounded-md transition-all ${\n                        qaFilter === \"archived\"\n                          ? \"bg-white text-slate-950 shadow-xs\"\n                          : \"text-slate-500 hover:text-slate-700\"\n                      }`}\n                    >\n                      Archived ({room.questions.filter(q => q.isArchived).length})\n                    </button>\n                  </div>\n                </div>\n\n                {filteredQuestions.length === 0 ? (\n                  <div className=\"border-2 border-dashed border-slate-200 rounded-2xl p-16 text-center text-slate-400 text-xs\">\n                    No questions in this filter.\n                  </div>\n                ) : (\n                  <div className=\"space-y-3\">\n                    <AnimatePresence initial={false}>\n                      {filteredQuestions.map((q) => (\n                        <motion.div\n                          key={q.id}\n                          initial={{ opacity: 0, y: 5 }}\n                          animate={{ opacity: 1, y: 0 }}\n                          exit={{ opacity: 0, scale: 0.98 }}\n                          layout\n                          className={`p-4 border rounded-xl flex items-start justify-between gap-4 bg-white transition-all ${\n                            q.isAnswered \n                              ? \"border-emerald-100 bg-emerald-50/5\" \n                              : q.isArchived \n                                ? \"border-slate-200/60 bg-slate-50/40 opacity-70\" \n                                : \"border-slate-200\"\n                          }`}\n                        >\n                          <div className=\"space-y-1.5 min-w-0\">\n                            <div className=\"flex flex-wrap items-center gap-2\">\n                              {q.isAnswered && (\n                                <span className=\"text-[9px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-100 px-1.5 py-0.5 rounded-md\">\n                                  \342\234\223 Answered\n                                </span>\n                              )}\n                              {q.isArchived && (\n                                <span className=\"text-[9px] font-bold text-slate-500 bg-slate-100 border border-slate-200 px-1.5 py-0.5 rounded-md\">\n                                  Archived\n                                </span>\n                              )}\n                              <span className=\"text-[10px] font-mono font-bold text-slate-400\">\n                                \342\226\262 {q.upvotes} {q.upvotes === 1 ? \"upvote\" : \"upvotes\"}\n                              </span>\n                            </div>\n                            <p className=\"text-xs sm:text-sm text-slate-800 font-semibold break-words leading-relaxed\">\n                              \"{q.text}\"\n                            </p>\n                            <span className=\"text-[10px] text-slate-400 block\">\n                              Asked at {new Date(q.createdAt).toLocaleTimeString([], { hour: \"2-digit\", minute: \"2-digit\" })}\n                            </span>\n                          </div>\n\n                          {/* Action Items */}\n                          <div className=\"flex items-center gap-1.5 shrink-0\">\n                            {/* Toggle Answered */}\n                            <button\n                              onClick={() => onToggleAnswered(q.id)}\n                              className={`p-1.5 border rounded-lg transition-all ${\n                                q.isAnswered\n                                  ? \"bg-slate-50 hover:bg-slate-100 border-slate-200 text-slate-500\"\n                                  : \"bg-emerald-50 hover:bg-emerald-100 border-emerald-100 text-emerald-700\"\n                              }`}\n                              title={q.isAnswered ? \"Mark as unanswered\" : \"Mark as answered live\"}\n                            >\n                              <Check className=\"h-4 w-4\" />\n                            </button>\n\n                            {/* Toggle Archive */}\n                            <button\n                              onClick={() => onToggleArchive(q.id)}\n                              className=\"p-1.5 border border-slate-200 hover:bg-slate-50 text-slate-500 rounded-lg transition-colors\"\n                              title={q.isArchived ? \"Unarchive question\" : \"Archive question (hide from audience)\"}\n                            >\n                              {q.isArchived ? <Eye className=\"h-4 w-4\" /> : <EyeOff className=\"h-4 w-4\" />}\n                            </button>\n\n                            {/* Delete */}\n                            <button\n                              onClick={() => onDeleteQuestion(q.id)}\n                              className=\"p-1.5 border border-transparent hover:border-rose-100 hover:bg-rose-50 text-slate-400 hover:text-rose-600 rounded-lg transition-colors\"\n                              title=\"Delete permanently\"\n                            >\n                              <Trash2 className=\"h-4 w-4\" />\n                            </button>\n                          </div>\n                        </motion.div>\n                      ))}\n                    </AnimatePresence>\n                  </div>\n                )}\n              </motion.div>\n            )}\n          </AnimatePresence>\n        </section>\n      </main>\n\n      {/* Control Footer */}\n      <footer className=\"border-t border-slate-200 bg-white py-4 text-center text-[10px] text-slate-400 font-medium\">\n        PulseLive Premium Presenter Dashboard. Auto-refresh is fully active and secured.\n      </footer>\n    </div>\n  );\n}\n"
