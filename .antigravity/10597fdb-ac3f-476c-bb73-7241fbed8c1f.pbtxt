    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React from \"react\";\nimport { QrCode, Vote, MessageSquare, Monitor, HelpCircle, ExternalLink } from \"lucide-react\";\nimport { Room, Poll, Question } from \"../types\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\ninterface ProjectorViewProps {\n  room: Room;\n  onClose: () => void;\n}\n\nexport default function ProjectorView({ room, onClose }: ProjectorViewProps) {\n  // Determine join link\n  const joinUrl = `${window.location.origin}/#/room/${room.id}`;\n  const qrCodeUrl = `https://api.qrserver.com/v1/create-qr-code/?size=350x350&data=${encodeURIComponent(joinUrl)}&color=0-0-0&bgcolor=255-255-255`;\n\n  // Active poll\n  const activePoll = room.polls.find(p => p.isActive);\n\n  // Filter out archived questions and sort by upvotes\n  const qaQuestions = room.questions\n    .filter(q => !q.isArchived)\n    .sort((a, b) => b.upvotes - a.upvotes)\n    .slice(0, 5); // top 5 questions to keep projector clean\n\n  // Calculate total votes\n  const getTotalVotes = (poll: Poll) => {\n    return Object.values(poll.votes).reduce((sum, count) => sum + count, 0);\n  };\n\n  const totalActivePollVotes = activePoll ? getTotalVotes(activePoll) : 0;\n\n  return (\n    <div className=\"min-h-screen bg-slate-900 text-slate-100 flex flex-col justify-between font-sans overflow-hidden\">\n      {/* Projector Header */}\n      <header className=\"border-b border-slate-800 bg-slate-950 px-8 py-4 flex items-center justify-between\">\n        <div className=\"flex items-center space-x-4\">\n          <div className=\"bg-indigo-600 text-white p-2.5 rounded-xl flex items-center justify-center\">\n            <Monitor className=\"h-6 w-6\" />\n          </div>\n          <div>\n            <h1 className=\"font-extrabold text-xl tracking-tight text-white flex items-center gap-2\">\n              Pulse<span className=\"text-indigo-400\">Live</span> Projector View\n            </h1>\n            <p className=\"text-xs text-slate-400 font-medium\">\n              Event Screen: <span className=\"text-indigo-300 font-semibold\">{room.title}</span>\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center space-x-6\">\n          <div className=\"bg-slate-800 border border-slate-700/80 px-4 py-2 rounded-xl text-center\">\n            <p className=\"text-[10px] uppercase font-bold tracking-wider text-slate-400\">\n              Join Instantly At\n            </p>\n            <p className=\"font-mono text-sm font-bold text-indigo-300\">\n              {window.location.host}\n            </p>\n          </div>\n          <div className=\"bg-indigo-600 border border-indigo-500 px-5 py-2 rounded-xl text-center shadow-lg shadow-indigo-900/30\">\n            <p className=\"text-[10px] uppercase font-bold tracking-wider text-indigo-200\">\n              Enter Room Code\n            </p>\n            <p className=\"font-mono text-xl font-black text-white tracking-widest\">\n              {room.id}\n            </p>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-xs font-semibold px-4 py-2 bg-slate-800 hover:bg-slate-700 hover:text-white rounded-lg transition-colors border border-slate-700\"\n          >\n            Exit Projector\n          </button>\n        </div>\n      </header>\n\n      {/* Main Split Layout */}\n      <main className=\"flex-grow p-8 grid grid-cols-12 gap-8 items-stretch overflow-hidden\">\n        {/* Left Side: Active Poll or Primary Content (Cols 1-8) */}\n        <section className=\"col-span-8 flex flex-col justify-center bg-slate-950/40 border border-slate-800/80 rounded-2xl p-8 shadow-2xl overflow-y-auto\">\n          <AnimatePresence mode=\"wait\">\n            {activePoll ? (\n              <motion.div\n                key={activePoll.id}\n                initial={{ opacity: 0, y: 15 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: -15 }}\n                className=\"space-y-6\"\n              >\n                <div>\n                  <span className=\"inline-flex items-center gap-1.5 px-3 py-1 bg-indigo-500/10 text-indigo-400 rounded-full text-xs font-bold border border-indigo-500/20 uppercase tracking-widest\">\n                    <Vote className=\"h-4 w-4\" /> Live Poll Results\n                  </span>\n                  <h2 className=\"text-3xl sm:text-4xl font-extrabold text-white mt-4 leading-tight\">\n                    {activePoll.question}\n                  </h2>\n                </div>\n\n                {/* Bars Chart Container */}\n                <div className=\"space-y-5 pt-4\">\n                  {activePoll.options.map((option, index) => {\n                    const votes = activePoll.votes[index] || 0;\n                    const percentage = totalActivePollVotes > 0 \n                      ? Math.round((votes / totalActivePollVotes) * 100) \n                      : 0;\n\n                    return (\n                      <div key={index} className=\"space-y-2\">\n                        <div className=\"flex justify-between items-center text-lg font-bold\">\n                          <span className=\"text-slate-200 truncate pr-4\">{option}</span>\n                          <span className=\"text-indigo-400 font-mono\">\n                            {percentage}% <span className=\"text-slate-500 text-sm font-semibold\">({votes} {votes === 1 ? \'vote\' : \'votes\'})</span>\n                          </span>\n                        </div>\n                        <div className=\"h-6 w-full bg-slate-800/60 border border-slate-800 rounded-lg overflow-hidden relative\">\n                          <motion.div\n                            initial={{ width: 0 }}\n                            animate={{ width: `${percentage}%` }}\n                            transition={{ duration: 0.8, ease: \"easeOut\" }}\n                            className=\"h-full bg-gradient-to-r from-indigo-600 to-violet-600 rounded-r-sm shadow-[0_0_15px_rgba(99,102,241,0.3)]\"\n                          ></motion.div>\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n\n                <div className=\"flex justify-between items-center pt-4 text-xs font-semibold text-slate-500 font-mono border-t border-slate-900\">\n                  <span>VOTING IN PROGRESS</span>\n                  <span>TOTAL PARTICIPANTS: {totalActivePollVotes}</span>\n                </div>\n              </motion.div>\n            ) : (\n              // If no active poll, present the top Q&A questions as main feature!\n              <motion.div\n                key=\"qa-feature\"\n                initial={{ opacity: 0 }}\n                animate={{ opacity: 1 }}\n                exit={{ opacity: 0 }}\n                className=\"space-y-6\"\n              >\n                <div>\n                  <span className=\"inline-flex items-center gap-1.5 px-3 py-1 bg-emerald-500/10 text-emerald-400 rounded-full text-xs font-bold border border-emerald-500/20 uppercase tracking-widest\">\n                    <MessageSquare className=\"h-4 w-4\" /> Live Audience Q&A Board\n                  </span>\n                  <h2 className=\"text-3xl font-extrabold text-white mt-4\">\n                    Send your questions at <span className=\"text-indigo-400 font-mono\">{window.location.host}</span> using room code <span className=\"text-indigo-400 font-mono\">{room.id}</span>\n                  </h2>\n                </div>\n\n                <div className=\"space-y-4 pt-4\">\n                  {qaQuestions.length === 0 ? (\n                    <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-12 text-center text-slate-400 text-lg space-y-2\">\n                      <HelpCircle className=\"h-12 w-12 text-slate-600 mx-auto animate-bounce\" />\n                      <p className=\"font-bold\">No questions submitted yet</p>\n                      <p className=\"text-sm\">Scan the QR code on the right to ask your first question!</p>\n                    </div>\n                  ) : (\n                    <div className=\"space-y-3\">\n                      {qaQuestions.map((q, idx) => (\n                        <motion.div\n                          key={q.id}\n                          initial={{ opacity: 0, x: -10 }}\n                          animate={{ opacity: 1, x: 0 }}\n                          transition={{ delay: idx * 0.1 }}\n                          className={`p-5 rounded-xl border flex justify-between items-center gap-4 ${\n                            q.isAnswered \n                              ? \"bg-emerald-950/20 border-emerald-900/50 text-emerald-300\"\n                              : \"bg-slate-900/60 border-slate-800 text-slate-200\"\n                          }`}\n                        >\n                          <div className=\"space-y-1.5 min-w-0\">\n                            {q.isAnswered && (\n                              <span className=\"inline-flex items-center text-[10px] font-bold text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded-md border border-emerald-900/30\">\n                                \342\234\223 Answered Live\n                              </span>\n                            )}\n                            <p className=\"text-base sm:text-lg font-semibold truncate-2-lines leading-snug\">\n                              \"{q.text}\"\n                            </p>\n                          </div>\n                          <div className=\"bg-slate-800 border border-slate-700/60 px-4 py-2.5 rounded-xl text-center shrink-0\">\n                            <span className=\"block text-xs font-bold text-slate-400 uppercase tracking-wider\">Upvotes</span>\n                            <span className=\"text-lg font-black text-indigo-300 font-mono\">{q.upvotes}</span>\n                          </div>\n                        </motion.div>\n                      ))}\n                    </div>\n                  )}\n                </div>\n              </motion.div>\n            )}\n          </AnimatePresence>\n        </section>\n\n        {/* Right Side: QR Code & Fast Joining Panel (Cols 9-12) */}\n        <section className=\"col-span-4 flex flex-col justify-between gap-6\">\n          {/* Joining QR Box */}\n          <div className=\"bg-slate-950/60 border border-slate-800/80 rounded-2xl p-6 text-center space-y-4 flex flex-col justify-center items-center flex-grow shadow-lg\">\n            <h3 className=\"text-xs font-bold tracking-widest text-slate-400 uppercase\">\n              Scan to Join Instantly\n            </h3>\n            \n            <div className=\"p-3 bg-white rounded-2xl shadow-xl hover:scale-102 transition-transform duration-200\">\n              <img \n                src={qrCodeUrl} \n                alt=\"PulseLive Join QR Code\" \n                className=\"h-44 w-44 sm:h-48 sm:w-48 object-contain\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </div>\n\n            <div className=\"space-y-1\">\n              <p className=\"text-xs text-slate-400\">\n                No logins. No downloads.\n              </p>\n              <p className=\"text-xs font-semibold text-indigo-300 flex items-center justify-center gap-1.5 font-mono\">\n                {joinUrl.replace(/(^\\w+:|^)\\/\\//, \"\")} <ExternalLink className=\"h-3 w-3\" />\n              </p>\n            </div>\n          </div>\n\n          {/* Q&A Side board (if active poll is showing) */}\n          {activePoll && (\n            <div className=\"bg-slate-950/60 border border-slate-800/80 rounded-2xl p-5 h-48 flex flex-col justify-between shadow-lg\">\n              <div className=\"flex justify-between items-center border-b border-slate-800 pb-2.5\">\n                <h3 className=\"text-[11px] font-bold tracking-widest text-slate-400 uppercase flex items-center gap-1\">\n                  <MessageSquare className=\"h-3.5 w-3.5 text-indigo-400\" /> Top Questions\n                </h3>\n                <span className=\"bg-slate-800 text-slate-300 text-[10px] font-bold px-1.5 py-0.2 rounded-md\">\n                  {room.questions.filter(q => !q.isArchived).length}\n                </span>\n              </div>\n\n              <div className=\"flex-grow overflow-y-auto space-y-2 py-2 text-xs\">\n                {qaQuestions.length === 0 ? (\n                  <p className=\"text-slate-500 text-center py-4 italic\">No questions yet</p>\n                ) : (\n                  qaQuestions.slice(0, 3).map((q) => (\n                    <div key={q.id} className=\"flex justify-between items-center gap-2 p-2 bg-slate-900/40 rounded-lg border border-slate-800/50\">\n                      <p className=\"truncate text-slate-300 font-medium flex-grow min-w-0 pr-1\">\n                        \"{q.text}\"\n                      </p>\n                      <span className=\"bg-indigo-900/30 border border-indigo-800/40 text-indigo-300 font-mono font-bold px-1.5 py-0.5 rounded-md text-[10px] shrink-0\">\n                        \342\226\262 {q.upvotes}\n                      </span>\n                    </div>\n                  ))\n                )}\n              </div>\n            </div>\n          )}\n        </section>\n      </main>\n\n      {/* Footer Instructions bar */}\n      <footer className=\"bg-slate-950 border-t border-slate-800 py-3.5 px-8 text-center text-xs font-semibold tracking-wide text-slate-500 font-mono\">\n        PULSELIVE PRESENTATION PORTAL \342\200\242 AUTO-REFRESHING EVERY 2 SECONDS \342\200\242 CURRENT TIME: {new Date().toLocaleTimeString()}\n      </footer>\n    </div>\n  );\n}"
      replacement_content: "import React from \"react\";\nimport { QrCode, Vote, MessageSquare, Monitor, HelpCircle, ExternalLink } from \"lucide-react\";\nimport { Room, Poll, Question } from \"../types\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\ninterface ProjectorViewProps {\n  room: Room;\n  onClose: () => void;\n}\n\nexport default function ProjectorView({ room, onClose }: ProjectorViewProps) {\n  // Determine join link\n  const joinUrl = `${window.location.origin}/#/room/${room.id}`;\n  const qrCodeUrl = `https://api.qrserver.com/v1/create-qr-code/?size=350x350&data=${encodeURIComponent(joinUrl)}&color=0-0-0&bgcolor=255-255-255`;\n\n  // Active poll\n  const activePoll = room.polls.find(p => p.isActive);\n\n  // Filter out archived questions and sort by upvotes\n  const qaQuestions = room.questions\n    .filter(q => !q.isArchived)\n    .sort((a, b) => b.upvotes - a.upvotes)\n    .slice(0, 5); // top 5 questions to keep projector clean\n\n  // Calculate total votes\n  const getTotalVotes = (poll: Poll) => {\n    return Object.values(poll.votes).reduce((sum, count) => sum + count, 0);\n  };\n\n  const totalActivePollVotes = activePoll ? getTotalVotes(activePoll) : 0;\n\n  return (\n    <div className=\"min-h-screen bg-[#09090B] text-white flex flex-col justify-between font-sans overflow-hidden selection:bg-accent-1 selection:text-black\">\n      {/* Projector Header */}\n      <header className=\"border-b-2 border-zinc-900 bg-[#09090B] px-8 py-5 flex items-center justify-between\">\n        <div className=\"flex items-center space-x-4\">\n          <div className=\"bg-white text-black p-2.5 rounded-none border-2 border-white flex items-center justify-center\">\n            <Monitor className=\"h-6 w-6 stroke-[2.5]\" />\n          </div>\n          <div>\n            <h1 className=\"font-black text-xl tracking-tight uppercase text-white flex items-center gap-2\">\n              PULSE<span className=\"text-accent-1 font-sans\">LIVE</span> PROJECTOR\n            </h1>\n            <p className=\"text-xs font-mono uppercase text-zinc-400\">\n              EVENT SCREEN: <span className=\"text-accent-1 font-bold\">{room.title}</span>\n            </p>\n          </div>\n        </div>\n\n        <div className=\"flex items-center space-x-6\">\n          <div className=\"bg-zinc-950 border-2 border-zinc-900 px-4 py-2 text-center\">\n            <p className=\"text-[9px] uppercase font-mono font-black tracking-widest text-zinc-500\">\n              JOIN INSTANTLY AT\n            </p>\n            <p className=\"font-mono text-sm font-bold text-accent-1 lowercase\">\n              {window.location.host}\n            </p>\n          </div>\n          <div className=\"bg-accent-1 text-black border-2 border-white px-5 py-2 text-center\">\n            <p className=\"text-[9px] uppercase font-mono font-black tracking-widest text-black/80\">\n              ROOM CODE\n            </p>\n            <p className=\"font-mono text-xl font-black tracking-widest text-black\">\n              {room.id}\n            </p>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-xs font-mono uppercase font-bold px-4 py-3 bg-zinc-900 hover:bg-zinc-800 text-zinc-300 hover:text-white transition-colors border-2 border-zinc-800 cursor-pointer\"\n          >\n            EXIT SCREEN\n          </button>\n        </div>\n      </header>\n\n      {/* Main Split Layout */}\n      <main className=\"flex-grow p-8 grid grid-cols-12 gap-8 items-stretch overflow-hidden\">\n        {/* Left Side: Active Poll or Primary Content (Cols 1-8) */}\n        <section className=\"col-span-8 flex flex-col justify-center bg-zinc-950/80 border-2 border-zinc-900 p-8 shadow-2xl overflow-y-auto\">\n          <AnimatePresence mode=\"wait\">\n            {activePoll ? (\n              <motion.div\n                key={activePoll.id}\n                initial={{ opacity: 0, y: 15 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: -15 }}\n                className=\"space-y-6\"\n              >\n                <div>\n                  <span className=\"inline-flex items-center gap-2 px-3 py-1.5 bg-accent-1/10 text-accent-1 border border-accent-1/20 text-xs font-mono font-black uppercase tracking-wider\">\n                    <Vote className=\"h-4 w-4\" /> LIVE POLL RESULTS\n                  </span>\n                  <h2 className=\"text-3xl sm:text-4xl font-black text-white uppercase tracking-tight mt-5 leading-none\">\n                    {activePoll.question}\n                  </h2>\n                </div>\n\n                {/* Bars Chart Container */}\n                <div className=\"space-y-5 pt-4\">\n                  {activePoll.options.map((option, index) => {\n                    const votes = activePoll.votes[index] || 0;\n                    const percentage = totalActivePollVotes > 0 \n                      ? Math.round((votes / totalActivePollVotes) * 100) \n                      : 0;\n\n                    return (\n                      <div key={index} className=\"space-y-2\">\n                        <div className=\"flex justify-between items-center text-lg font-bold\">\n                          <span className=\"text-zinc-200 truncate pr-4\">{option}</span>\n                          <span className=\"text-accent-1 font-mono font-black\">\n                            {percentage}% <span className=\"text-zinc-500 text-sm font-medium\">({votes} {votes === 1 ? \'vote\' : \'votes\'})</span>\n                          </span>\n                        </div>\n                        <div className=\"h-7 w-full bg-zinc-900 border-2 border-zinc-850 rounded-none overflow-hidden relative\">\n                          <motion.div\n                            initial={{ width: 0 }}\n                            animate={{ width: `${percentage}%` }}\n                            transition={{ duration: 0.8, ease: \"easeOut\" }}\n                            className=\"h-full bg-gradient-to-r from-accent-1 to-accent-2\"\n                          ></motion.div>\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n\n                <div className=\"flex justify-between items-center pt-4 text-xs font-bold text-zinc-500 font-mono border-t border-zinc-900 uppercase tracking-widest\">\n                  <span>VOTING IN PROGRESS \342\200\242 REALTIME</span>\n                  <span>TOTAL RESPONSES: {totalActivePollVotes}</span>\n                </div>\n              </motion.div>\n            ) : (\n              // If no active poll, present the top Q&A questions as main feature!\n              <motion.div\n                key=\"qa-feature\"\n                initial={{ opacity: 0 }}\n                animate={{ opacity: 1 }}\n                exit={{ opacity: 0 }}\n                className=\"space-y-6\"\n              >\n                <div>\n                  <span className=\"inline-flex items-center gap-2 px-3 py-1.5 bg-accent-3/10 text-accent-3 border border-accent-3/20 text-xs font-mono font-black uppercase tracking-wider\">\n                    <MessageSquare className=\"h-4 w-4\" /> LIVE AUDIENCE Q&A BOARD\n                  </span>\n                  <h2 className=\"text-2xl font-black text-white uppercase tracking-tight mt-5 leading-snug\">\n                    SEND YOUR QUESTIONS AT <span className=\"text-accent-3 font-mono\">{window.location.host}</span> USING CODE <span className=\"text-accent-3 font-mono\">{room.id}</span>\n                  </h2>\n                </div>\n\n                <div className=\"space-y-4 pt-4\">\n                  {qaQuestions.length === 0 ? (\n                    <div className=\"bg-zinc-900/50 border-2 border-zinc-900 p-12 text-center text-zinc-500 text-lg space-y-3\">\n                      <HelpCircle className=\"h-12 w-12 text-zinc-600 mx-auto animate-bounce\" />\n                      <p className=\"font-mono font-black uppercase text-zinc-400\">No questions submitted yet</p>\n                      <p className=\"text-sm font-light text-zinc-550\">Scan the QR code on the right to ask your first question!</p>\n                    </div>\n                  ) : (\n                    <div className=\"space-y-3\">\n                      {qaQuestions.map((q, idx) => (\n                        <motion.div\n                          key={q.id}\n                          initial={{ opacity: 0, x: -10 }}\n                          animate={{ opacity: 1, x: 0 }}\n                          transition={{ delay: idx * 0.1 }}\n                          className={`p-5 border-2 flex justify-between items-center gap-4 ${\n                            q.isAnswered \n                              ? \"bg-emerald-950/20 border-emerald-900/40 text-emerald-300\"\n                              : \"bg-zinc-900/40 border-zinc-900 text-zinc-200\"\n                          }`}\n                        >\n                          <div className=\"space-y-1.5 min-w-0\">\n                            {q.isAnswered && (\n                              <span className=\"inline-flex items-center text-[9px] font-mono font-black text-emerald-400 bg-emerald-950/60 px-2 py-0.5 border border-emerald-900/30 uppercase\">\n                                \342\234\223 Answered Live\n                              </span>\n                            )}\n                            <p className=\"text-base sm:text-lg font-bold truncate-2-lines leading-snug\">\n                              \"{q.text}\"\n                            </p>\n                          </div>\n                          <div className=\"bg-zinc-950 border-2 border-zinc-900 px-4 py-2.5 text-center shrink-0\">\n                            <span className=\"block text-[9px] font-mono font-black text-zinc-500 uppercase tracking-widest\">Upvotes</span>\n                            <span className=\"text-lg font-black text-accent-3 font-mono\">{q.upvotes}</span>\n                          </div>\n                        </motion.div>\n                      ))}\n                    </div>\n                  )}\n                </div>\n              </motion.div>\n            )}\n          </AnimatePresence>\n        </section>\n\n        {/* Right Side: QR Code & Fast Joining Panel (Cols 9-12) */}\n        <section className=\"col-span-4 flex flex-col justify-between gap-6\">\n          {/* Joining QR Box */}\n          <div className=\"bg-zinc-950 border-2 border-zinc-900 p-6 text-center space-y-5 flex flex-col justify-center items-center flex-grow shadow-lg\">\n            <h3 className=\"text-xs font-mono font-black tracking-widest text-zinc-400 uppercase\">\n              SCAN TO JOIN INSTANTLY\n            </h3>\n            \n            <div className=\"p-3 bg-white hover:scale-102 transition-transform duration-200 border-2 border-zinc-800\">\n              <img \n                src={qrCodeUrl} \n                alt=\"PulseLive Join QR Code\" \n                className=\"h-44 w-44 sm:h-48 sm:w-48 object-contain\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </div>\n\n            <div className=\"space-y-1.5\">\n              <p className=\"text-xs font-mono uppercase text-zinc-500\">\n                No logins. No downloads.\n              </p>\n              <p className=\"text-xs font-bold text-accent-1 flex items-center justify-center gap-1.5 font-mono lowercase\">\n                {joinUrl.replace(/(^\\w+:|^)\\/\\//, \"\")} <ExternalLink className=\"h-3 w-3\" />\n              </p>\n            </div>\n          </div>\n\n          {/* Q&A Side board (if active poll is showing) */}\n          {activePoll && (\n            <div className=\"bg-zinc-950 border-2 border-zinc-900 p-5 h-48 flex flex-col justify-between shadow-lg\">\n              <div className=\"flex justify-between items-center border-b border-zinc-900 pb-2.5\">\n                <h3 className=\"text-[10px] font-mono font-black tracking-widest text-zinc-400 uppercase flex items-center gap-1.5\">\n                  <MessageSquare className=\"h-3.5 w-3.5 text-accent-3\" /> TOP QUESTIONS\n                </h3>\n                <span className=\"bg-zinc-900 border border-zinc-850 text-zinc-300 text-[10px] font-mono px-2 py-0.5\">\n                  {room.questions.filter(q => !q.isArchived).length}\n                </span>\n              </div>\n\n              <div className=\"flex-grow overflow-y-auto space-y-2 py-2 text-xs\">\n                {qaQuestions.length === 0 ? (\n                  <p className=\"text-zinc-600 text-center py-4 font-mono uppercase text-[10px]\">No questions yet</p>\n                ) : (\n                  qaQuestions.slice(0, 3).map((q) => (\n                    <div key={q.id} className=\"flex justify-between items-center gap-2 p-2 bg-zinc-900/30 rounded-none border border-zinc-900\">\n                      <p className=\"truncate text-zinc-300 font-medium flex-grow min-w-0 pr-1 text-[11px]\">\n                        \"{q.text}\"\n                      </p>\n                      <span className=\"bg-zinc-950 border border-zinc-900 text-accent-3 font-mono font-bold px-1.5 py-0.5 text-[10px] shrink-0\">\n                        \342\226\262 {q.upvotes}\n                      </span>\n                    </div>\n                  ))\n                )}\n              </div>\n            </div>\n          )}\n        </section>\n      </main>\n\n      {/* Footer Instructions bar */}\n      <footer className=\"bg-[#09090B] border-t-2 border-zinc-900 py-4 px-8 text-center text-xs font-bold tracking-widest text-zinc-500 font-mono uppercase\">\n        PULSELIVE PRESENTATION PORTAL \342\200\242 AUTO-SYNC ACTIVE \342\200\242 EVENT IS LIVE\n      </footer>\n    </div>\n  );\n}"
    }
