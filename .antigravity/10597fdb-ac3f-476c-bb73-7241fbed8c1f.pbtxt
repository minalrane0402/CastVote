  file_change {
    absolute_path_uri: "file:///src/components/LandingPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { Vote, MessageSquare, QrCode, Sparkles, ChevronRight, Play, ArrowRight } from \"lucide-react\";\nimport { motion } from \"motion/react\";\n\ninterface LandingPageProps {\n  onCreateRoom: (title: string) => void;\n  onJoinRoom: (code: string) => void;\n  isLoading: boolean;\n  error: string | null;\n}\n\nexport default function LandingPage({ onCreateRoom, onJoinRoom, isLoading, error }: LandingPageProps) {\n  const [joinCode, setJoinCode] = useState(\"\");\n  const [roomTitle, setRoomTitle] = useState(\"\");\n  const [activeTab, setActiveTab] = useState<\"join\" | \"create\">(\"join\");\n\n  const handleJoinSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!joinCode.trim()) return;\n    onJoinRoom(joinCode.trim().toUpperCase());\n  };\n\n  const handleCreateSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!roomTitle.trim()) return;\n    onCreateRoom(roomTitle.trim());\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 flex flex-col justify-between font-sans\">\n      {/* Header */}\n      <header className=\"border-b border-slate-200/80 bg-white/80 backdrop-blur-md sticky top-0 z-50\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\">\n          <div className=\"flex items-center space-x-3\">\n            <div className=\"bg-indigo-600 text-white p-2 rounded-xl shadow-lg shadow-indigo-100 flex items-center justify-center\">\n              <Vote className=\"h-5 w-5 animate-pulse\" />\n            </div>\n            <div>\n              <span className=\"font-sans font-bold text-xl tracking-tight text-slate-900\">\n                Pulse<span className=\"text-indigo-600\">Live</span>\n              </span>\n              <span className=\"ml-2 px-1.5 py-0.5 text-[10px] font-medium font-mono uppercase bg-emerald-50 text-emerald-700 rounded-md border border-emerald-200/50\">\n                Realtime\n              </span>\n            </div>\n          </div>\n          \n          <div className=\"hidden sm:flex items-center space-x-6 text-sm font-medium text-slate-500\">\n            <span className=\"flex items-center gap-1\">\n              <Vote className=\"h-4 w-4 text-slate-400\" /> Real-time Polls\n            </span>\n            <span className=\"flex items-center gap-1\">\n              <MessageSquare className=\"h-4 w-4 text-slate-400\" /> Interactive Q&A\n            </span>\n          </div>\n        </div>\n      </header>\n\n      {/* Hero / Action Area */}\n      <main className=\"flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20 flex flex-col lg:flex-row items-center gap-12 lg:gap-16\">\n        <div className=\"flex-1 space-y-6 text-center lg:text-left\">\n          <motion.div\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.5 }}\n            className=\"inline-flex items-center gap-1.5 px-3 py-1.5 bg-indigo-50 text-indigo-700 rounded-full text-xs font-semibold\"\n          >\n            <Sparkles className=\"h-3.5 w-3.5\" /> Zero installation. 100% web-based.\n          </motion.div>\n          \n          <motion.h1\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.5, delay: 0.1 }}\n            className=\"text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-tight\"\n          >\n            Engage Your Audience <br />\n            <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-600\">\n              In Real Time\n            </span>\n          </motion.h1>\n\n          <motion.p\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.5, delay: 0.2 }}\n            className=\"text-lg text-slate-600 max-w-xl mx-auto lg:mx-0 font-normal leading-relaxed\"\n          >\n            A lightweight Slido or Mentimeter replacement. Presenters create a room, audiences scan a QR code on their phones to vote and ask questions, and results sync instantly.\n          </motion.p>\n\n          <motion.div\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.5, delay: 0.3 }}\n            className=\"pt-4 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start\"\n          >\n            <button\n              onClick={() => onJoinRoom(\"DEMO\")}\n              className=\"group inline-flex items-center justify-center gap-2 px-6 py-3 bg-slate-900 hover:bg-slate-800 text-white rounded-xl font-medium shadow-md transition-all duration-200\"\n            >\n              <Play className=\"h-4 w-4 fill-white\" /> Try Live DEMO Room\n              <ArrowRight className=\"h-4 w-4 transition-transform group-hover:translate-x-1\" />\n            </button>\n          </motion.div>\n        </div>\n\n        {/* Right card: Join/Create Tabs */}\n        <motion.div\n          initial={{ opacity: 0, scale: 0.98 }}\n          animate={{ opacity: 1, scale: 1 }}\n          transition={{ duration: 0.5, delay: 0.15 }}\n          className=\"w-full max-w-md bg-white border border-slate-200/80 rounded-2xl shadow-xl shadow-slate-100 p-6 sm:p-8\"\n        >\n          {/* Tabs */}\n          <div className=\"flex border-b border-slate-100 pb-4 mb-6\">\n            <button\n              onClick={() => setActiveTab(\"join\")}\n              className={`flex-1 text-center pb-3 text-sm font-semibold border-b-2 transition-all ${\n                activeTab === \"join\"\n                  ? \"border-indigo-600 text-indigo-600\"\n                  : \"border-transparent text-slate-400 hover:text-slate-600\"\n              }`}\n            >\n              Join a Session\n            </button>\n            <button\n              onClick={() => setActiveTab(\"create\")}\n              className={`flex-1 text-center pb-3 text-sm font-semibold border-b-2 transition-all ${\n                activeTab === \"create\"\n                  ? \"border-indigo-600 text-indigo-600\"\n                  : \"border-transparent text-slate-400 hover:text-slate-600\"\n              }`}\n            >\n              Create a Session\n            </button>\n          </div>\n\n          {error && (\n            <div className=\"mb-4 p-3 bg-rose-50 text-rose-700 text-xs font-medium rounded-lg border border-rose-100 flex items-center\">\n              <span className=\"mr-1\">\342\232\240\357\270\217</span> {error}\n            </div>\n          )}\n\n          {activeTab === \"join\" ? (\n            <form onSubmit={handleJoinSubmit} className=\"space-y-4\">\n              <div>\n                <label className=\"block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2\">\n                  Enter Room Code\n                </label>\n                <input\n                  type=\"text\"\n                  maxLength={5}\n                  value={joinCode}\n                  onChange={(e) => setJoinCode(e.target.value)}\n                  placeholder=\"e.g. DEMO\"\n                  className=\"w-full text-center text-3xl font-bold tracking-widest uppercase bg-slate-50 border border-slate-200 hover:border-slate-300 focus:border-indigo-500 focus:bg-white focus:outline-none rounded-xl py-4 transition-all\"\n                  disabled={isLoading}\n                  autoFocus\n                />\n              </div>\n              <button\n                type=\"submit\"\n                className=\"w-full py-3.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl shadow-lg shadow-indigo-100 transition-all flex items-center justify-center gap-2\"\n                disabled={isLoading}\n              >\n                {isLoading ? \"Joining...\" : \"Join Event\"}\n                <ChevronRight className=\"h-5 w-5\" />\n              </button>\n              <p className=\"text-center text-xs text-slate-400\">\n                Audience joins instantly. No logins, no credentials.\n              </p>\n            </form>\n          ) : (\n            <form onSubmit={handleCreateSubmit} className=\"space-y-4\">\n              <div>\n                <label className=\"block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2\">\n                  Event / Session Title\n                </label>\n                <input\n                  type=\"text\"\n                  value={roomTitle}\n                  onChange={(e) => setRoomTitle(e.target.value)}\n                  placeholder=\"e.g. Weekly All-Hands Meeting\"\n                  className=\"w-full bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:bg-white focus:outline-none rounded-xl px-4 py-3 text-sm font-medium transition-all\"\n                  disabled={isLoading}\n                  autoFocus\n                />\n              </div>\n              <button\n                type=\"submit\"\n                className=\"w-full py-3.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl shadow-lg shadow-indigo-100 transition-all flex items-center justify-center gap-2\"\n                disabled={isLoading}\n              >\n                {isLoading ? \"Creating...\" : \"Create Event Room\"}\n                <ChevronRight className=\"h-5 w-5\" />\n              </button>\n              <p className=\"text-center text-xs text-slate-400\">\n                You will receive a room code and a shareable presenter dashboard.\n              </p>\n            </form>\n          )}\n        </motion.div>\n      </main>\n\n      {/* Feature pillars section */}\n      <section className=\"bg-white border-t border-slate-200/50 py-12 sm:py-16\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n            <div className=\"flex gap-4 p-4 rounded-xl hover:bg-slate-50/50 transition-colors\">\n              <div className=\"bg-indigo-50 text-indigo-600 p-3 h-12 w-12 rounded-xl flex items-center justify-center shrink-0\">\n                <Vote className=\"h-6 w-6\" />\n              </div>\n              <div>\n                <h3 className=\"font-semibold text-slate-900 mb-1\">Instant Realtime Polls</h3>\n                <p className=\"text-sm text-slate-500 leading-relaxed\">\n                  Design multiple-choice polls on the fly. Results stream in on-screen as soon as audience members tap their choice.\n                </p>\n              </div>\n            </div>\n\n            <div className=\"flex gap-4 p-4 rounded-xl hover:bg-slate-50/50 transition-colors\">\n              <div className=\"bg-indigo-50 text-indigo-600 p-3 h-12 w-12 rounded-xl flex items-center justify-center shrink-0\">\n                <MessageSquare className=\"h-6 w-6\" />\n              </div>\n              <div>\n                <h3 className=\"font-semibold text-slate-900 mb-1\">Upvoted Q&A Boards</h3>\n                <p className=\"text-sm text-slate-500 leading-relaxed\">\n                  Let your audience ask anonymous questions. Other participants upvote popular questions so the presenter always addresses the most burning topics.\n                </p>\n              </div>\n            </div>\n\n            <div className=\"flex gap-4 p-4 rounded-xl hover:bg-slate-50/50 transition-colors\">\n              <div className=\"bg-indigo-50 text-indigo-600 p-3 h-12 w-12 rounded-xl flex items-center justify-center shrink-0\">\n                <QrCode className=\"h-6 w-6\" />\n              </div>\n              <div>\n                <h3 className=\"font-semibold text-slate-900 mb-1\">Sleek QR Code Joining</h3>\n                <p className=\"text-sm text-slate-500 leading-relaxed\">\n                  Projector mode generates a custom scannable QR code. Audience scans and lands directly in the active room inside 2 seconds.\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* Footer */}\n      <footer className=\"bg-slate-900 text-slate-400 py-6 text-center text-xs border-t border-slate-800\">\n        <div className=\"max-w-7xl mx-auto px-4 flex flex-col sm:flex-row justify-between items-center gap-2\">\n          <div>\n            &copy; 2026 PulseLive Inc. Lightweight engagement, solved.\n          </div>\n          <div className=\"font-mono text-slate-500\">\n            Current session ID isolation is fully secured.\n          </div>\n        </div>\n      </footer>\n    </div>\n  );\n}\n"
    }
