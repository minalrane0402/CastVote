        }
        lines {
          text: "  const filteredQuestions = room.questions.filter(q => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (qaFilter === \"answered\") return q.isAnswered && !q.isArchived;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (qaFilter === \"archived\") return q.isArchived;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return !q.isAnswered && !q.isArchived; // active"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  }).sort((a, b) => b.upvotes - a.upvotes); // sorted by upvotes desc"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
