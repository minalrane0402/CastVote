  file_change {
    absolute_path_uri: "file:///src/components/ParticipantView.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState } from \"react\";\nimport { Vote, MessageSquare, Send, ThumbsUp, HelpCircle, RefreshCw } from \"lucide-react\";\nimport { Room, Poll, Question } from \"../types\";\nimport { getOrCreateUserId } from \"../lib/api\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\ninterface ParticipantViewProps {\n  room: Room;\n  onVote: (pollId: string, optionIndex: number) => void;\n  onAskQuestion: (text: string) => void;\n  onUpvoteQuestion: (questionId: string) => void;\n  onLeave: () => void;\n  isSyncing: boolean;\n  onForceRefresh: () => void;\n}\n\nexport default function ParticipantView({\n  room,\n  onVote,\n  onAskQuestion,\n  onUpvoteQuestion,\n  onLeave,\n  isSyncing,\n  onForceRefresh\n}: ParticipantViewProps) {\n  const [activeTab, setActiveTab] = useState<\"polls\" | \"qa\">(\"polls\");\n  const [questionText, setQuestionText] = useState(\"\");\n  const [qaSort, setQaSort] = useState<\"top\" | \"recent\">(\"top\");\n  const [votedLocalPolls, setVotedLocalPolls] = useState<string[]>([]); // optimization to show local voted state immediately\n  \n  const userId = getOrCreateUserId();\n\n  // Find the currently active poll\n  const activePoll = room.polls.find(p => p.isActive);\n\n  // Check if current user has voted on the active poll\n  const hasVotedActivePoll = activePoll \n    ? activePoll.votedUsers.includes(userId) || votedLocalPolls.includes(activePoll.id)\n    : false;\n\n  const handleVoteSubmit = (optionIndex: number) => {\n    if (!activePoll) return;\n    onVote(activePoll.id, optionIndex);\n    setVotedLocalPolls(prev => [...prev, activePoll.id]);\n  };\n\n  const handleQuestionSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!questionText.trim()) return;\n    onAskQuestion(questionText.trim());\n    setQuestionText(\"\");\n  };\n\n  // Filter out archived questions for participants\n  const visibleQuestions = room.questions.filter(q => !q.isArchived);\n\n  // Sort questions\n  const sortedQuestions = [...visibleQuestions].sort((a, b) => {\n    if (qaSort === \"top\") {\n      // Primary: upvotes desc, Secondary: date desc\n      if (b.upvotes !== a.upvotes) {\n        return b.upvotes - a.upvotes;\n      }\n      return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();\n    } else {\n      // Recent: date desc\n      return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();\n    }\n  });\n\n  // Calculate total votes for active poll to show percentages\n  const getTotalVotes = (poll: Poll) => {\n    return Object.values(poll.votes).reduce((sum, count) => sum + count, 0);\n  };\n\n  const totalActivePollVotes = activePoll ? getTotalVotes(activePoll) : 0;\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 flex flex-col justify-between font-sans\">\n      {/* Mobile-optimized Header */}\n      <header className=\"sticky top-0 bg-white border-b border-slate-200/80 z-40 shadow-xs px-4 py-3\">\n        <div className=\"max-w-md mx-auto flex items-center justify-between\">\n          <div className=\"flex items-center space-x-2\">\n            <button \n              onClick={onLeave}\n              className=\"text-slate-400 hover:text-slate-600 text-xs font-semibold px-2 py-1 hover:bg-slate-100 rounded-md transition-colors\"\n            >\n              \342\206\220 Leave\n            </button>\n            <div className=\"h-4 w-px bg-slate-200\"></div>\n            <div>\n              <h1 className=\"font-bold text-slate-900 text-sm truncate max-w-[150px] sm:max-w-[200px]\" title={room.title}>\n                {room.title}\n              </h1>\n              <p className=\"text-[10px] text-indigo-600 font-bold tracking-wider uppercase\">\n                Code: {room.id}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center space-x-2\">\n            <button\n              onClick={onForceRefresh}\n              className={`p-1.5 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors ${\n                isSyncing ? \"animate-spin text-indigo-600\" : \"\"\n              }`}\n              title=\"Force refresh\"\n            >\n              <RefreshCw className=\"h-4 w-4\" />\n            </button>\n            <span className=\"flex h-2 w-2 relative\">\n              <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\"></span>\n              <span className=\"relative inline-flex rounded-full h-2 w-2 bg-emerald-500\"></span>\n            </span>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Content */}\n      <main className=\"flex-grow max-w-md w-full mx-auto px-4 py-6 overflow-y-auto\">\n        {/* Tab Selection */}\n        <div className=\"flex bg-slate-200/60 p-1 rounded-xl mb-6\">\n          <button\n            onClick={() => setActiveTab(\"polls\")}\n            className={`flex-1 flex items-center justify-center gap-2 py-2.5 text-xs font-semibold rounded-lg transition-all ${\n              activeTab === \"polls\"\n                ? \"bg-white text-slate-950 shadow-xs\"\n                : \"text-slate-500 hover:text-slate-700\"\n            }`}\n          >\n            <Vote className=\"h-4 w-4\" />\n            Live Polls\n            {activePoll && !hasVotedActivePoll && (\n              <span className=\"h-2 w-2 rounded-full bg-indigo-600 animate-pulse\"></span>\n            )}\n          </button>\n          <button\n            onClick={() => setActiveTab(\"qa\")}\n            className={`flex-1 flex items-center justify-center gap-2 py-2.5 text-xs font-semibold rounded-lg transition-all ${\n              activeTab === \"qa\"\n                ? \"bg-white text-slate-950 shadow-xs\"\n                : \"text-slate-500 hover:text-slate-700\"\n            }`}\n          >\n            <MessageSquare className=\"h-4 w-4\" />\n            Audience Q&A\n            {visibleQuestions.length > 0 && (\n              <span className=\"bg-slate-200 text-slate-700 text-[10px] px-1.5 py-0.2 rounded-full font-bold\">\n                {visibleQuestions.length}\n              </span>\n            )}\n          </button>\n        </div>\n\n        {/* Tab Contents */}\n        <div className=\"space-y-4\">\n          <AnimatePresence mode=\"wait\">\n            {activeTab === \"polls\" ? (\n              <motion.div\n                key=\"polls-tab\"\n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: -10 }}\n                transition={{ duration: 0.2 }}\n                className=\"space-y-4\"\n              >\n                {!activePoll ? (\n                  <div className=\"bg-white border border-slate-200 rounded-2xl p-8 text-center space-y-4 shadow-sm shadow-slate-100\">\n                    <div className=\"w-16 h-16 bg-slate-50 text-slate-400 rounded-full flex items-center justify-center mx-auto border border-slate-100\">\n                      <HelpCircle className=\"h-8 w-8 animate-bounce\" />\n                    </div>\n                    <div className=\"space-y-1\">\n                      <h3 className=\"font-bold text-slate-900 text-base\">No active polls</h3>\n                      <p className=\"text-xs text-slate-500 max-w-xs mx-auto\">\n                        The presenter hasn\'t opened a poll yet. Hang tight! They will appear here in real time.\n                      </p>\n                    </div>\n                    <div className=\"inline-flex items-center gap-1.5 px-3 py-1 bg-indigo-50 text-indigo-700 rounded-full text-[11px] font-semibold\">\n                      <span className=\"h-1.5 w-1.5 rounded-full bg-indigo-600 animate-ping\"></span>\n                      Listening for changes...\n                    </div>\n                  </div>\n                ) : (\n                  <div className=\"bg-white border border-slate-200 rounded-2xl p-5 sm:p-6 shadow-sm shadow-slate-100 space-y-5\">\n                    <div>\n                      <span className=\"text-[10px] font-bold text-indigo-600 uppercase tracking-widest bg-indigo-50 px-2 py-0.5 rounded-md\">\n                        Active Poll\n                      </span>\n                      <h2 className=\"text-base sm:text-lg font-bold text-slate-900 mt-2.5 leading-snug\">\n                        {activePoll.question}\n                      </h2>\n                    </div>\n\n                    {!hasVotedActivePoll ? (\n                      <div className=\"space-y-3\">\n                        {activePoll.options.map((option, index) => (\n                          <button\n                            key={index}\n                            onClick={() => handleVoteSubmit(index)}\n                            className=\"w-full text-left p-4 border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/20 active:bg-indigo-50/50 rounded-xl font-medium text-xs sm:text-sm text-slate-800 transition-all duration-150 flex justify-between items-center\"\n                          >\n                            <span>{option}</span>\n                            <span className=\"w-5 h-5 rounded-full border border-slate-300 flex items-center justify-center shrink-0\">\n                              <span className=\"w-2.5 h-2.5 rounded-full bg-transparent hover:bg-slate-300\"></span>\n                            </span>\n                          </button>\n                        ))}\n                      </div>\n                    ) : (\n                      <div className=\"space-y-4\">\n                        <div className=\"p-3 bg-emerald-50 text-emerald-800 rounded-lg text-xs font-semibold border border-emerald-100 text-center\">\n                          \342\234\223 Vote submitted successfully! Thank you.\n                        </div>\n\n                        <div className=\"space-y-3\">\n                          <h4 className=\"text-xs font-bold text-slate-400 uppercase tracking-wider\">\n                            Live Results ({totalActivePollVotes} {totalActivePollVotes === 1 ? \"vote\" : \"votes\"})\n                          </h4>\n                          \n                          {activePoll.options.map((option, index) => {\n                            const count = activePoll.votes[index] || 0;\n                            const pct = totalActivePollVotes > 0 \n                              ? Math.round((count / totalActivePollVotes) * 100) \n                              : 0;\n\n                            return (\n                              <div key={index} className=\"space-y-1.5\">\n                                <div className=\"flex justify-between items-center text-xs font-semibold text-slate-700\">\n                                  <span className=\"truncate max-w-[250px]\">{option}</span>\n                                  <span>{pct}% ({count})</span>\n                                </div>\n                                <div className=\"h-3 w-full bg-slate-100 rounded-full overflow-hidden\">\n                                  <motion.div\n                                    initial={{ width: 0 }}\n                                    animate={{ width: `${pct}%` }}\n                                    transition={{ duration: 0.5, ease: \"easeOut\" }}\n                                    className=\"h-full bg-indigo-600 rounded-full\"\n                                  ></motion.div>\n                                </div>\n                              </div>\n                            );\n                          })}\n                        </div>\n                        <p className=\"text-center text-[10px] text-slate-400\">\n                          Waiting for the presenter to trigger the next poll.\n                        </p>\n                      </div>\n                    )}\n                  </div>\n                )}\n              </motion.div>\n            ) : (\n              <motion.div\n                key=\"qa-tab\"\n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: -10 }}\n                transition={{ duration: 0.2 }}\n                className=\"space-y-4\"\n              >\n                {/* Submit Question Card */}\n                <div className=\"bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm shadow-slate-100\">\n                  <h3 className=\"text-xs font-bold text-slate-900 uppercase tracking-wider mb-3\">\n                    Ask the Presenter\n                  </h3>\n                  <form onSubmit={handleQuestionSubmit} className=\"space-y-3\">\n                    <div className=\"relative\">\n                      <textarea\n                        value={questionText}\n                        onChange={(e) => setQuestionText(e.target.value.slice(0, 150))}\n                        placeholder=\"Type your question anonymously...\"\n                        className=\"w-full h-20 bg-slate-50 border border-slate-200 focus:border-indigo-500 focus:bg-white focus:outline-none rounded-xl px-4 py-3 text-xs sm:text-sm font-medium transition-all resize-none\"\n                        required\n                      />\n                      <span className=\"absolute bottom-2 right-3 text-[10px] font-semibold text-slate-400\">\n                        {questionText.length}/150\n                      </span>\n                    </div>\n                    <button\n                      type=\"submit\"\n                      disabled={!questionText.trim()}\n                      className=\"w-full py-2.5 px-4 bg-indigo-600 disabled:bg-slate-200 text-white disabled:text-slate-400 hover:bg-indigo-500 font-semibold rounded-xl text-xs transition-all flex items-center justify-center gap-2 shadow-sm\"\n                    >\n                      <Send className=\"h-3.5 w-3.5\" />\n                      Submit Question\n                    </button>\n                  </form>\n                </div>\n\n                {/* Sort Bar */}\n                <div className=\"flex items-center justify-between text-xs text-slate-500 px-1 py-1\">\n                  <span className=\"font-semibold text-slate-700\">\n                    Questions ({visibleQuestions.length})\n                  </span>\n                  <div className=\"flex bg-slate-200/50 p-0.5 rounded-lg border border-slate-200\">\n                    <button\n                      onClick={() => setQaSort(\"top\")}\n                      className={`px-2.5 py-1 font-bold rounded-md transition-all ${\n                        qaSort === \"top\"\n                          ? \"bg-white text-slate-900 shadow-xs\"\n                          : \"text-slate-500 hover:text-slate-700\"\n                      }`}\n                    >\n                      Top Upvoted\n                    </button>\n                    <button\n                      onClick={() => setQaSort(\"recent\")}\n                      className={`px-2.5 py-1 font-bold rounded-md transition-all ${\n                        qaSort === \"recent\"\n                          ? \"bg-white text-slate-900 shadow-xs\"\n                          : \"text-slate-500 hover:text-slate-700\"\n                      }`}\n                    >\n                      Most Recent\n                    </button>\n                  </div>\n                </div>\n\n                {/* Questions List */}\n                <div className=\"space-y-3\">\n                  {sortedQuestions.length === 0 ? (\n                    <div className=\"bg-white border border-slate-200 rounded-2xl p-8 text-center text-slate-400 text-xs\">\n                      No questions submitted yet. Be the first to ask!\n                    </div>\n                  ) : (\n                    <AnimatePresence initial={false}>\n                      {sortedQuestions.map((question) => {\n                        const hasUpvoted = question.upvotedBy.includes(userId);\n                        return (\n                          <motion.div\n                            key={question.id}\n                            initial={{ opacity: 0, y: 5 }}\n                            animate={{ opacity: 1, y: 0 }}\n                            exit={{ opacity: 0, scale: 0.95 }}\n                            layout\n                            className={`p-4 border rounded-xl shadow-xs transition-all flex items-start gap-3 bg-white ${\n                              question.isAnswered ? \"border-emerald-100 bg-emerald-50/10\" : \"border-slate-200\"\n                            }`}\n                          >\n                            <div className=\"flex-grow space-y-1.5 min-w-0\">\n                              {question.isAnswered && (\n                                <span className=\"inline-flex items-center gap-1 text-[9px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-100 px-1.5 py-0.5 rounded-md\">\n                                  \342\234\223 Answered Live\n                                </span>\n                              )}\n                              <p className=\"text-xs sm:text-sm text-slate-800 font-medium break-words leading-relaxed\">\n                                {question.text}\n                              </p>\n                              <div className=\"flex items-center text-[10px] text-slate-400 space-x-1.5\">\n                                <span>Anonymous</span>\n                                <span>\342\200\242</span>\n                                <span>\n                                  {new Date(question.createdAt).toLocaleTimeString([], {\n                                    hour: \"2-digit\",\n                                    minute: \"2-digit\",\n                                  })}\n                                </span>\n                              </div>\n                            </div>\n\n                            <button\n                              onClick={() => onUpvoteQuestion(question.id)}\n                              className={`flex flex-col items-center justify-center p-2 rounded-xl border transition-all gap-1 shrink-0 w-11 ${\n                                hasUpvoted\n                                  ? \"bg-indigo-50 border-indigo-200 text-indigo-700\"\n                                  : \"bg-slate-50 hover:bg-slate-100 border-slate-200 text-slate-500\"\n                              }`}\n                            >\n                              <ThumbsUp className={`h-3.5 w-3.5 ${hasUpvoted ? \"fill-indigo-600\" : \"\"}`} />\n                              <span className=\"text-[10px] font-bold\">{question.upvotes}</span>\n                            </button>\n                          </motion.div>\n                        );\n                      })}\n                    </AnimatePresence>\n                  )}\n                </div>\n              </motion.div>\n            )}\n          </AnimatePresence>\n        </div>\n      </main>\n\n      {/* Footer Branding */}\n      <footer className=\"border-t border-slate-200 bg-white text-center py-3 px-4 text-[10px] font-medium text-slate-400\">\n        Powered by PulseLive. Scan & Vote. No account needed.\n      </footer>\n    </div>\n  );\n}"
      replacement_content: "import React, { useState } from \"react\";\nimport { Vote, MessageSquare, Send, ThumbsUp, HelpCircle, RefreshCw } from \"lucide-react\";\nimport { Room, Poll, Question } from \"../types\";\nimport { getOrCreateUserId } from \"../lib/api\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\ninterface ParticipantViewProps {\n  room: Room;\n  onVote: (pollId: string, optionIndex: number) => void;\n  onAskQuestion: (text: string) => void;\n  onUpvoteQuestion: (questionId: string) => void;\n  onLeave: () => void;\n  isSyncing: boolean;\n  onForceRefresh: () => void;\n}\n\nexport default function ParticipantView({\n  room,\n  onVote,\n  onAskQuestion,\n  onUpvoteQuestion,\n  onLeave,\n  isSyncing,\n  onForceRefresh\n}: ParticipantViewProps) {\n  const [activeTab, setActiveTab] = useState<\"polls\" | \"qa\">(\"polls\");\n  const [questionText, setQuestionText] = useState(\"\");\n  const [qaSort, setQaSort] = useState<\"top\" | \"recent\">(\"top\");\n  const [votedLocalPolls, setVotedLocalPolls] = useState<string[]>([]); // optimization to show local voted state immediately\n  \n  const userId = getOrCreateUserId();\n\n  // Find the currently active poll\n  const activePoll = room.polls.find(p => p.isActive);\n\n  // Check if current user has voted on the active poll\n  const hasVotedActivePoll = activePoll \n    ? activePoll.votedUsers.includes(userId) || votedLocalPolls.includes(activePoll.id)\n    : false;\n\n  const handleVoteSubmit = (optionIndex: number) => {\n    if (!activePoll) return;\n    onVote(activePoll.id, optionIndex);\n    setVotedLocalPolls(prev => [...prev, activePoll.id]);\n  };\n\n  const handleQuestionSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!questionText.trim()) return;\n    onAskQuestion(questionText.trim());\n    setQuestionText(\"\");\n  };\n\n  // Filter out archived questions for participants\n  const visibleQuestions = room.questions.filter(q => !q.isArchived);\n\n  // Sort questions\n  const sortedQuestions = [...visibleQuestions].sort((a, b) => {\n    if (qaSort === \"top\") {\n      if (b.upvotes !== a.upvotes) {\n        return b.upvotes - a.upvotes;\n      }\n      return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();\n    } else {\n      return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();\n    }\n  });\n\n  // Calculate total votes for active poll to show percentages\n  const getTotalVotes = (poll: Poll) => {\n    return Object.values(poll.votes).reduce((sum, count) => sum + count, 0);\n  };\n\n  const totalActivePollVotes = activePoll ? getTotalVotes(activePoll) : 0;\n\n  return (\n    <div className=\"min-h-screen bg-[#09090B] text-white flex flex-col justify-between font-sans selection:bg-accent-1 selection:text-black\">\n      {/* Mobile-optimized Header */}\n      <header className=\"sticky top-0 bg-[#09090B]/95 border-b-2 border-zinc-900 z-40 backdrop-blur-md px-4 py-4\">\n        <div className=\"max-w-md mx-auto flex items-center justify-between\">\n          <div className=\"flex items-center space-x-3\">\n            <button \n              onClick={onLeave}\n              className=\"text-zinc-400 hover:text-white text-xs font-mono uppercase tracking-wider px-2.5 py-1.5 bg-zinc-900 border border-zinc-800 transition-colors cursor-pointer\"\n            >\n              \342\206\220 LEAVE\n            </button>\n            <div className=\"h-5 w-px bg-zinc-800\"></div>\n            <div>\n              <h1 className=\"font-black text-white text-sm tracking-tight truncate max-w-[140px] sm:max-w-[180px]\" title={room.title}>\n                {room.title}\n              </h1>\n              <p className=\"text-[10px] text-accent-1 font-bold font-mono tracking-wider\">\n                CODE: {room.id}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center space-x-3\">\n            <button\n              onClick={onForceRefresh}\n              className={`p-2 bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-white transition-colors cursor-pointer ${\n                isSyncing ? \"animate-spin text-accent-1 border-accent-1/40\" : \"\"\n              }`}\n              title=\"Force refresh\"\n            >\n              <RefreshCw className=\"h-4 w-4\" />\n            </button>\n            <span className=\"flex h-2.5 w-2.5 relative\">\n              <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-1 opacity-75\"></span>\n              <span className=\"relative inline-flex rounded-full h-2.5 w-2.5 bg-accent-1\"></span>\n            </span>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Content */}\n      <main className=\"flex-grow max-w-md w-full mx-auto px-4 py-6 overflow-y-auto\">\n        {/* Tab Selection */}\n        <div className=\"flex bg-zinc-950 border-2 border-zinc-900 p-1 mb-6 rounded-none\">\n          <button\n            onClick={() => setActiveTab(\"polls\")}\n            className={`flex-1 flex items-center justify-center gap-2 py-3 text-xs font-mono uppercase font-black transition-all ${\n              activeTab === \"polls\"\n                ? \"bg-zinc-900 text-accent-1 border border-accent-1/30\"\n                : \"text-zinc-500 hover:text-zinc-300\"\n            }`}\n          >\n            <Vote className=\"h-4 w-4\" />\n            Live Polls\n            {activePoll && !hasVotedActivePoll && (\n              <span className=\"h-2 w-2 rounded-full bg-accent-1 animate-pulse\"></span>\n            )}\n          </button>\n          <button\n            onClick={() => setActiveTab(\"qa\")}\n            className={`flex-1 flex items-center justify-center gap-2 py-3 text-xs font-mono uppercase font-black transition-all ${\n              activeTab === \"qa\"\n                ? \"bg-zinc-900 text-accent-3 border border-accent-3/30\"\n                : \"text-zinc-500 hover:text-zinc-300\"\n            }`}\n          >\n            <MessageSquare className=\"h-4 w-4\" />\n            Audience Q&A\n            {visibleQuestions.length > 0 && (\n              <span className=\"bg-zinc-800 text-zinc-300 text-[10px] px-1.5 py-0.2 font-mono\">\n                {visibleQuestions.length}\n              </span>\n            )}\n          </button>\n        </div>\n\n        {/* Tab Contents */}\n        <div className=\"space-y-4\">\n          <AnimatePresence mode=\"wait\">\n            {activeTab === \"polls\" ? (\n              <motion.div\n                key=\"polls-tab\"\n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: -10 }}\n                transition={{ duration: 0.2 }}\n                className=\"space-y-4\"\n              >\n                {!activePoll ? (\n                  <div className=\"bg-zinc-950 border-2 border-zinc-900 p-8 text-center space-y-4 rounded-none\">\n                    <div className=\"w-16 h-16 bg-zinc-900 text-zinc-500 rounded-none flex items-center justify-center mx-auto border-2 border-zinc-800\">\n                      <HelpCircle className=\"h-8 w-8 animate-bounce text-accent-1\" />\n                    </div>\n                    <div className=\"space-y-1\">\n                      <h3 className=\"font-mono font-bold uppercase text-white tracking-wide text-sm\">No active polls</h3>\n                      <p className=\"text-xs text-zinc-400 max-w-xs mx-auto\">\n                        The presenter hasn\'t opened a poll yet. Hang tight! They will appear here in real time.\n                      </p>\n                    </div>\n                    <div className=\"inline-flex items-center gap-2 px-3 py-1.5 bg-accent-1/10 text-accent-1 border border-accent-1/20 text-[11px] font-mono uppercase\">\n                      <span className=\"h-1.5 w-1.5 rounded-full bg-accent-1 animate-ping\"></span>\n                      Listening for changes...\n                    </div>\n                  </div>\n                ) : (\n                  <div className=\"bg-zinc-950 border-2 border-zinc-900 p-5 sm:p-6 rounded-none space-y-5\">\n                    <div>\n                      <span className=\"text-[10px] font-mono font-black text-accent-1 uppercase tracking-widest bg-accent-1/10 border border-accent-1/30 px-2.5 py-1\">\n                        Active Poll\n                      </span>\n                      <h2 className=\"text-base sm:text-lg font-bold text-white mt-4 leading-snug\">\n                        {activePoll.question}\n                      </h2>\n                    </div>\n\n                    {!hasVotedActivePoll ? (\n                      <div className=\"space-y-3\">\n                        {activePoll.options.map((option, index) => (\n                          <button\n                            key={index}\n                            onClick={() => handleVoteSubmit(index)}\n                            className=\"w-full text-left p-4 bg-zinc-900/40 border-2 border-zinc-850 hover:border-accent-1 hover:bg-zinc-900 active:bg-zinc-900 text-xs sm:text-sm text-zinc-200 hover:text-white transition-all duration-150 flex justify-between items-center cursor-pointer font-medium\"\n                          >\n                            <span>{option}</span>\n                            <span className=\"w-5 h-5 rounded-none border-2 border-zinc-700 flex items-center justify-center shrink-0 group-hover:border-accent-1\">\n                              <span className=\"w-2.5 h-2.5 bg-transparent\"></span>\n                            </span>\n                          </button>\n                        ))}\n                      </div>\n                    ) : (\n                      <div className=\"space-y-4\">\n                        <div className=\"p-3 bg-accent-1/10 text-accent-1 text-xs font-mono uppercase tracking-wide border border-accent-1/30 text-center\">\n                          \342\234\223 Vote submitted successfully!\n                        </div>\n\n                        <div className=\"space-y-3\">\n                          <h4 className=\"text-xs font-mono font-black text-zinc-500 uppercase tracking-widest\">\n                            Live Results ({totalActivePollVotes} {totalActivePollVotes === 1 ? \"vote\" : \"votes\"})\n                          </h4>\n                          \n                          {activePoll.options.map((option, index) => {\n                            const count = activePoll.votes[index] || 0;\n                            const pct = totalActivePollVotes > 0 \n                              ? Math.round((count / totalActivePollVotes) * 100) \n                              : 0;\n\n                            return (\n                              <div key={index} className=\"space-y-1.5\">\n                                <div className=\"flex justify-between items-center text-xs font-semibold text-zinc-300\">\n                                  <span className=\"truncate max-w-[250px]\">{option}</span>\n                                  <span className=\"font-mono text-accent-1\">{pct}% ({count})</span>\n                                </div>\n                                <div className=\"h-3.5 w-full bg-zinc-900 border border-zinc-800 rounded-none overflow-hidden\">\n                                  <motion.div\n                                    initial={{ width: 0 }}\n                                    animate={{ width: `${pct}%` }}\n                                    transition={{ duration: 0.5, ease: \"easeOut\" }}\n                                    className=\"h-full bg-gradient-to-r from-accent-1 to-accent-2\"\n                                  ></motion.div>\n                                </div>\n                              </div>\n                            );\n                          })}\n                        </div>\n                        <p className=\"text-center text-[10px] font-mono uppercase text-zinc-500\">\n                          Waiting for the presenter to trigger the next poll.\n                        </p>\n                      </div>\n                    )}\n                  </div>\n                )}\n              </motion.div>\n            ) : (\n              <motion.div\n                key=\"qa-tab\"\n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                exit={{ opacity: 0, y: -10 }}\n                transition={{ duration: 0.2 }}\n                className=\"space-y-4\"\n              >\n                {/* Submit Question Card */}\n                <div className=\"bg-zinc-950 border-2 border-zinc-900 p-4 sm:p-5 rounded-none\">\n                  <h3 className=\"text-xs font-mono font-black text-white uppercase tracking-widest mb-3\">\n                    Ask the Presenter\n                  </h3>\n                  <form onSubmit={handleQuestionSubmit} className=\"space-y-3\">\n                    <div className=\"relative\">\n                      <textarea\n                        value={questionText}\n                        onChange={(e) => setQuestionText(e.target.value.slice(0, 150))}\n                        placeholder=\"Type your question anonymously...\"\n                        className=\"w-full h-20 bg-zinc-900 border-2 border-zinc-850 focus:border-accent-3 focus:bg-[#121214] focus:outline-none rounded-none px-4 py-3.5 text-xs sm:text-sm font-medium transition-all resize-none text-white placeholder-zinc-650\"\n                        required\n                      />\n                      <span className=\"absolute bottom-2.5 right-3 text-[10px] font-mono text-zinc-500\">\n                        {questionText.length}/150\n                      </span>\n                    </div>\n                    <button\n                      type=\"submit\"\n                      disabled={!questionText.trim()}\n                      className=\"w-full py-3 px-4 bg-accent-3 disabled:bg-zinc-900 text-black disabled:text-zinc-600 hover:bg-pink-300 font-mono font-black uppercase text-xs tracking-wider transition-all flex items-center justify-center gap-2 cursor-pointer\"\n                    >\n                      <Send className=\"h-3.5 w-3.5 stroke-[3]\" />\n                      Submit Question\n                    </button>\n                  </form>\n                </div>\n\n                {/* Sort Bar */}\n                <div className=\"flex items-center justify-between text-xs text-zinc-400 px-1 py-1\">\n                  <span className=\"font-mono font-bold uppercase tracking-wider text-white\">\n                    Questions ({visibleQuestions.length})\n                  </span>\n                  <div className=\"flex bg-zinc-950 p-0.5 border border-zinc-900\">\n                    <button\n                      onClick={() => setQaSort(\"top\")}\n                      className={`px-3 py-1 text-[11px] font-mono uppercase font-bold transition-all ${\n                        qaSort === \"top\"\n                          ? \"bg-zinc-900 text-accent-3 border border-accent-3/20\"\n                          : \"text-zinc-500 hover:text-zinc-300\"\n                      }`}\n                    >\n                      Top\n                    </button>\n                    <button\n                      onClick={() => setQaSort(\"recent\")}\n                      className={`px-3 py-1 text-[11px] font-mono uppercase font-bold transition-all ${\n                        qaSort === \"recent\"\n                          ? \"bg-zinc-900 text-accent-3 border border-accent-3/20\"\n                          : \"text-zinc-500 hover:text-zinc-300\"\n                      }`}\n                    >\n                      Recent\n                    </button>\n                  </div>\n                </div>\n\n                {/* Questions List */}\n                <div className=\"space-y-3\">\n                  {sortedQuestions.length === 0 ? (\n                    <div className=\"bg-zinc-950 border-2 border-zinc-900 p-8 text-center text-zinc-500 text-xs font-mono uppercase\">\n                      No questions yet. Be the first!\n                    </div>\n                  ) : (\n                    <AnimatePresence initial={false}>\n                      {sortedQuestions.map((question) => {\n                        const hasUpvoted = question.upvotedBy.includes(userId);\n                        return (\n                          <motion.div\n                            key={question.id}\n                            initial={{ opacity: 0, y: 5 }}\n                            animate={{ opacity: 1, y: 0 }}\n                            exit={{ opacity: 0, scale: 0.95 }}\n                            layout\n                            className={`p-4 border-2 transition-all flex items-start gap-4 bg-zinc-950 ${\n                              question.isAnswered ? \"border-emerald-900/60 bg-emerald-950/10\" : \"border-zinc-900\"\n                            }`}\n                          >\n                            <div className=\"flex-grow space-y-2 min-w-0\">\n                              {question.isAnswered && (\n                                <span className=\"inline-flex items-center gap-1 text-[9px] font-mono font-black text-emerald-400 bg-emerald-950 border border-emerald-800 px-2 py-0.5 uppercase\">\n                                  \342\234\223 Answered Live\n                                </span>\n                              )}\n                              <p className=\"text-xs sm:text-sm text-zinc-100 font-medium break-words leading-relaxed\">\n                                {question.text}\n                              </p>\n                              <div className=\"flex items-center text-[10px] font-mono text-zinc-500 space-x-1.5\">\n                                <span>ANONYMOUS</span>\n                                <span>\342\200\242</span>\n                                <span>\n                                  {new Date(question.createdAt).toLocaleTimeString([], {\n                                    hour: \"2-digit\",\n                                    minute: \"2-digit\",\n                                  })}\n                                </span>\n                              </div>\n                            </div>\n\n                            <button\n                              onClick={() => onUpvoteQuestion(question.id)}\n                              className={`flex flex-col items-center justify-center p-2.5 border-2 transition-all gap-1 shrink-0 w-11 cursor-pointer ${\n                                hasUpvoted\n                                  ? \"bg-accent-1/10 border-accent-1 text-accent-1\"\n                                  : \"bg-zinc-900 border-zinc-850 text-zinc-500 hover:text-zinc-300 hover:border-zinc-700\"\n                              }`}\n                            >\n                              <ThumbsUp className={`h-3.5 w-3.5 ${hasUpvoted ? \"fill-accent-1\" : \"\"}`} />\n                              <span className=\"text-[10px] font-mono font-black\">{question.upvotes}</span>\n                            </button>\n                          </motion.div>\n                        );\n                      })}\n                    </AnimatePresence>\n                  )}\n                </div>\n              </motion.div>\n            )}\n          </AnimatePresence>\n        </div>\n      </main>\n\n      {/* Footer Branding */}\n      <footer className=\"border-t border-zinc-900 bg-black text-center py-4 px-4 text-[10px] font-mono uppercase tracking-wider text-zinc-500\">\n        Powered by PulseLive. Scan & Vote. No account needed.\n      </footer>\n    </div>\n  );\n}"
    }
